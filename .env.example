# ============================================================
# ZERSOFT Bilişim & Danışmanlık — .env Şablon Dosyası
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin:
#   cp .env.example .env
#
# .env dosyası git'e commit edilmez, bu şablon edilir.
# ============================================================

# -----------------------------------------------------------
# Veritabanı Ayarları (cPanel MySQL)
# cPanel > MySQL Databases > yeni veritabanı ve kullanıcı oluşturun
# -----------------------------------------------------------
DB_HOST=localhost
DB_NAME=cpanel_veritabani_adi
DB_USER=cpanel_kullanici_adi
DB_PASS=guclu_bir_sifre_girin
DB_CHARSET=utf8mb4

# -----------------------------------------------------------
# Site Genel Ayarları
# APP_ENV: local | production
# APP_DEBUG: true sadece geliştirme ortamında kullanın
# -----------------------------------------------------------
APP_ENV=production
APP_URL=https://zersoft.net
APP_DEBUG=false

# -----------------------------------------------------------
# Admin Güvenlik Ayarları
# ADMIN_SESSION_LIFETIME: Saniye cinsinden oturum süresi (3600 = 1 saat)
# ADMIN_MAX_LOGIN_ATTEMPTS: Başarısız giriş sayısı limiti
# -----------------------------------------------------------
ADMIN_SESSION_LIFETIME=3600
ADMIN_MAX_LOGIN_ATTEMPTS=5

# -----------------------------------------------------------
# İletişim & E-posta
# -----------------------------------------------------------
MAIL_FROM=info@zersoft.net
MAIL_FROM_NAME=ZERSOFT Bilişim

# -----------------------------------------------------------
# Oturum Güvenliği
# SESSION_SECURE: HTTPS kullanılıyorsa true yapın
# SESSION_HTTPONLY: XSS saldırılarına karşı her zaman true bırakın
# -----------------------------------------------------------
SESSION_SECURE=true
SESSION_HTTPONLY=true
